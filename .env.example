# Google GenAI: se aceptan también GOOGLE_API_KEY y GEMINI_API_KEY por compatibilidad.
GOOGLE_GENAI_API_KEY=your_google_genai_key
GOOGLE_GENAI_MODEL=gemini-3.5-flash

# Qdrant Cloud (o usa QDRANT_HOST, QDRANT_PORT y QDRANT_HTTPS).
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_key
COLLECTION_NAME=mireya_collection

# Separa varios orígenes con comas. "*" es útil solo durante desarrollo.
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app
SERVICE_API_KEY=optional_service_key

# Historial persistente de chat (usar la service role key solo en el backend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DEFAULT_USER_ID=default
